# DERB MOBILE - example local settings file.
#
# Copy this to `.env.local` (which git ignores) and fill in your own values, or
# let `bash scripts/set_ai_key.sh` write it for you with a hidden prompt so the
# key never appears in your shell history.
#
# Only keys beginning with DERB_ are read, and a real environment variable
# always wins over a value here. See README -> "Connecting an AI provider".

# Which AI client to use: "gemini" or "openai-images" (default).
DERB_AI_PROVIDER=gemini

# Your provider API key. REQUIRED. Never commit this file.
DERB_AI_API_KEY=replace-me

# Optional overrides
#DERB_AI_IMAGE_MODEL=gemini-2.5-flash-image
#DERB_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#DERB_AI_TIMEOUT=90
