# DERB MOBILE - runtime artifacts stay on the phone, code goes to git

# Python
__pycache__/
*.pyc
.venv/

# Local database + uploaded passport photos / design images (real customer data)
data/derb.db
data/derb.db-wal
data/derb.db-shm
data/photos/*
!data/photos/.gitkeep
data/design_images/*
!data/design_images/.gitkeep

# Generated customer documents (real customer data)
DERB/CV/Projects/*
DERB/CV/PDF/*
DERB/CV/DOCX/*
DERB/Letters/*
DERB/Documents/*
DERB/School/*
DERB/Business/*
DERB/Passport/*
DERB/Designs/*
DERB/Templates/*
!DERB/**/.gitkeep

# Local secrets - never commit an AI provider key (see README)
.env
.env.*
*.env
# Keep the committed example (no real values) trackable.
!.env.example

# OS noise
.DS_Store
Thumbs.db
